{
  "name": "@esho-plans/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --var LOCAL_DEV:true --var CONTENT_HOST:localhost",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "wrangler types .wrangler/worker-configuration.d.ts --include-runtime=false && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.166.0"
  }
}
